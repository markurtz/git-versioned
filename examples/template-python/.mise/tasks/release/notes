#!/usr/bin/env bash
#MISE description="Print the CHANGELOG.md section of one release, for the GitHub release body"
#USAGE arg "<tag>"
set -euo pipefail
version="${1:?usage: release:notes <tag>}"
version="${version#v}"
awk -v heading="## [$version]" '
  index($0, heading) == 1 { found = 1; next }
  found && /^## \[/ { exit }
  found { print }
' CHANGELOG.md | sed -e '/./,$!d'
