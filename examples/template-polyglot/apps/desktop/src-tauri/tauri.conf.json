{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "template-polyglot",
  "identifier": "io.github.markurtz.template-polyglot",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "mise run web:serve",
    "beforeBuildCommand": "mise run --quiet --skip-deps desktop:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "template-polyglot",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "Apache-2.0"
  }
}
